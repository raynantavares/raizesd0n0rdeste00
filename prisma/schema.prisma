generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENTE
  ATENDENTE
  COZINHA
  GERENTE
  ADMIN
}

enum CanalPedido {
  APP
  TOTEM
  BALCAO
  PICKUP
  WEB
}

enum StatusPedido {
  AGUARDANDO_PAGAMENTO
  PAGO
  PAGAMENTO_NEGADO
  EM_PREPARO
  PRONTO
  ENTREGUE
  CANCELADO
}

enum StatusPagamento {
  PENDENTE
  APROVADO
  NEGADO
  FALHA
}

enum FormaPagamento {
  MOCK
}

model Usuario {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senhaHash String
  role      Role     @default(CLIENTE)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pedidos    Pedido[]
  pagamentos Pagamento[]
  auditLogs  AuditLog[]
}

model Unidade {
  id        String   @id @default(uuid())
  nome      String
  cidade    String
  ativa     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  produtos Produto[]
  pedidos  Pedido[]
}

model Produto {
  id        String   @id @default(uuid())
  unidadeId String
  nome      String
  descricao String?
  preco     Decimal  @db.Decimal(10, 2)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unidade Unidade      @relation(fields: [unidadeId], references: [id])
  itens   PedidoItem[]

  @@index([unidadeId])
}

model Pedido {
  id           String       @id @default(uuid())
  clienteId    String
  unidadeId    String
  canalPedido  CanalPedido
  status       StatusPedido @default(AGUARDANDO_PAGAMENTO)
  total        Decimal      @db.Decimal(10, 2)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  cliente    Usuario     @relation(fields: [clienteId], references: [id])
  unidade    Unidade     @relation(fields: [unidadeId], references: [id])
  itens      PedidoItem[]
  pagamentos Pagamento[]

  @@index([canalPedido])
  @@index([status])
  @@index([clienteId])
}

model PedidoItem {
  id            String  @id @default(uuid())
  pedidoId      String
  produtoId     String
  quantidade    Int
  precoUnitario Decimal @db.Decimal(10, 2)
  subtotal      Decimal @db.Decimal(10, 2)

  pedido  Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id])

  @@index([pedidoId])
}

model Pagamento {
  id             String          @id @default(uuid())
  pedidoId       String
  solicitadoPorId String
  formaPagamento FormaPagamento  @default(MOCK)
  status         StatusPagamento @default(PENDENTE)
  valor          Decimal         @db.Decimal(10, 2)
  payloadRetorno Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  pedido        Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  solicitadoPor Usuario @relation(fields: [solicitadoPorId], references: [id])

  @@index([pedidoId])
}

model AuditLog {
  id        String   @id @default(uuid())
  usuarioId String?
  acao      String
  entidade  String
  entidadeId String?
  detalhes  Json?
  createdAt DateTime @default(now())

  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([entidade, entidadeId])
}
